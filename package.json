{
  "name": "calcite-notes",
  "version": "1.1.0",
  "private": true,
  "description": "A local-first Markdown editor and linked-note workspace for desktop and mobile",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "icons": "electron scripts/icons.cjs",
    "notices": "node scripts/notices.cjs",
    "package": "node scripts/package.cjs",
    "test": "node scripts/smoke.cjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test:unit": "node --test tests/core/*.test.mjs",
    "test:smoke": "npm run build && node scripts/smoke-suite.cjs",
    "verify:licenses": "node scripts/check-licenses.cjs && npm run notices",
    "build:production": "node scripts/build-production.cjs",
    "verify:all": "npm run typecheck && npm run test:unit && npm run test:smoke && npm run verify:licenses && npm run build:production",
    "mobile:sync": "npm run build && npx cap sync",
    "capacitor:copy:after": "node scripts/mobile-notices.cjs",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run mobile:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/crepe": "7.23.0",
    "@milkdown/utils": "7.23.0",
    "@replit/codemirror-vim": "6.4.0",
    "bonjour-service": "1.4.4",
    "buffer": "6.0.3",
    "chokidar": "5.0.0",
    "codemirror": "^6.0.0",
    "d3-force": "3.0.1",
    "diff3": "0.0.3",
    "dompurify": "^3.2.0",
    "fflate": "0.8.3",
    "highlight.js": "^11.11.0",
    "isomorphic-git": "1.44.17",
    "js-yaml": "^4.3.2",
    "jsqr": "1.4.0",
    "katex": "^0.16.22",
    "lucide": "^0.468.0",
    "marked": "^15.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "mermaid": "^11.6.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "electron": "45.4.1",
    "electron-builder": "^26.0.0",
    "playwright": "^1.55.0",
    "typescript": "5.9.3",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "io.calcite.notes",
    "productName": "Calcite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "dir"
    },
    "asar": true
  }
}
